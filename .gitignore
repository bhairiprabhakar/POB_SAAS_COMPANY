# ── Environment / secrets ──────────────────────────────────────────────────
.env
*.env
!.env.example

# ── Python ─────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# ── Node / frontend build ──────────────────────────────────────────────────
web/node_modules/
web/dist/
npm-debug.log*

# ── Runtime data (never commit tenant files) ───────────────────────────────
uploads/*
!uploads/.gitkeep
storage/*
!storage/.gitkeep
backups/*

# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# SSR smoke-test build artifact (regenerated by web/build_ssr.mjs)
web/ssr_smoke.bundle.mjs

# Runtime credential notes (contains real passwords)
dummy_credentials.txt
